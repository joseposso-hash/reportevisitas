generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("TECNICO")
  pin       String?
  activo    Boolean  @default(true)
  tecnico   Tecnico?
  createdAt DateTime @default(now())
  @@schema("public")
}

model Tecnico {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  telefono  String?
  visitas   Visita[]
  @@schema("public")
}

model Cliente {
  id           String   @id @default(uuid())
  razonSocial  String
  nit          String?  @unique
  contactoNom  String?
  contactoTel  String?
  contactoMail String?
  direccion    String?
  ciudad       String?
  activo       Boolean  @default(true)
  sedes        Sede[]
  visitas      Visita[]
  createdAt    DateTime @default(now())
  @@schema("public")
}

model Sede {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  direccion String?
  ciudad    String?
  equipos   Equipo[]
  visitas   Visita[]
  @@schema("public")
}

model Equipo {
  id                   String   @id @default(uuid())
  sedeId               String
  sede                 Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  tipo                 String
  marca                String?
  modelo               String?
  serial               String?
  ubicacion            String?
  ip                   String?
  usuario              String?
  clave                String?
  estadoFisico         String?
  estadoFuncional      String?
  observaciones        String?
  fechaUltimoManto     DateTime?
  proximoManto         DateTime?
  activo               Boolean  @default(true)
  fotos                FotoEquipo[]
  @@schema("public")
}

model FotoEquipo {
  id          String   @id @default(uuid())
  equipoId    String
  equipo      Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  url         String?  // <-- El '?' lo hace opcional
  base64      String?  @db.Text
  descripcion String?
  createdAt   DateTime @default(now())
  @@schema("public")
}
model Visita {
  id                    String                  @id @default(uuid())
  folio                 String                  @unique
  clienteId             String
  cliente               Cliente                 @relation(fields: [clienteId], references: [id])
  sedeId                String
  sede                  Sede                    @relation(fields: [sedeId], references: [id])
  tecnicoId             String
  tecnico               Tecnico                 @relation(fields: [tecnicoId], references: [id])
  tipoServicio          String
  estado                String                  @default("ASIGNADA")
  fechaProgramada       DateTime
  horaCheckin           DateTime?
  horaCheckout          DateTime?
  estadoGeneral         String?
  observaciones         String?
  requerimientosCliente String?
  firmaClienteUrl       String?
  firmaClienteNombre    String?
  pdfUrl                String?
  fotos                 Foto[]
  checklist             ChecklistItemVisita[]
  cotizacion            Cotizacion?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  @@schema("public")
}

model ChecklistItemVisita {
  id          String  @id @default(uuid())
  visitaId    String
  visita      Visita  @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  descripcion String
  completado  Boolean @default(false)
  nota        String?
  @@schema("public")
}

model Foto {
  id          String   @id @default(uuid())
  visitaId    String
  visita      Visita   @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  url         String
  categoria   String
  descripcion String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  @@schema("public")
}

model Cotizacion {
  id                String           @id @default(uuid())
  visitaId          String           @unique
  visita            Visita           @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  numero            String           @unique
  estado            String           @default("BORRADOR")
  subtotal          Float            @default(0)
  iva               Float            @default(0)
  total             Float            @default(0)
  ivaPorcentaje     Int              @default(19)
  validezDias       Int              @default(15)
  notas             String?
  fechaVencimiento  DateTime?
  tokenAprobacion   String?          @unique
  aprobadaPorNombre String?
  aprobadaPorCargo  String?
  razonRechazo      String?
  items             CotizacionItem[]
  createdAt         DateTime         @default(now())
  @@schema("public")
}

model CotizacionItem {
  id             String     @id @default(uuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  descripcion    String
  cantidad       Int
  precioUnitario Float
  totalLinea     Float
  @@schema("public")
}